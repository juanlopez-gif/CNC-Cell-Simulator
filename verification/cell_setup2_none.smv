INVAR cmd = c246 -> SUP = I_x; -- SUP: I -> X1
INVAR cmd = c247 -> (SUP = X1_x & CAM_FAULT); -- SUP: X1 -> X3
INVAR cmd = c248 -> (SUP = X1_x & (mismatches in {1, 2, 3} & !(CAM_FAULT))); -- SUP: X1 -> X2
INVAR cmd = c249 -> (SUP = X2_x & (mismatches = 3 | CAM_FAULT)); -- SUP: X2 -> X3
INVAR cmd = c250 -> (SUP = X2_x & (mismatches = 0 & !((mismatches = 3 | CAM_FAULT)))); -- SUP: X2 -> X1
INVAR cmd = c251 -> (SUP = X3_x & ((r1Home & !(R1 in {B0_0, B1_1, B2_0, B3_0, B4_0, B4_1, B4_2, B5_0, B5_1, B6_1, B7_0, B7_3, W1_0, H_0})) & (r2Home & !(R2 in {E0_0, E0_3, E1_0, E2_0, E3_0, E4_0, E5_1, E5_3, E6_0, E6_1, E7_0, H_0})) & !(moving))); -- SUP: X3 -> X4 [HMI.verify]
INVAR cmd = c252 -> SUP = X4_x; -- SUP: X4 -> X4 [VERIFY.fail]
INVAR cmd = c253 -> SUP = X4_x; -- SUP: X4 -> X1 [VERIFY.pass, HMI.reset]
INVAR cmd = c254 -> (run & cnc = raw); -- CNC: CNC: cycle complete (part OK or undersized)
INVAR cmd = c255 -> (run & !(cnc = raw)); -- CNC: CNC: cycle complete (empty)
INVAR cmd = c256 -> (!(run) & lock & cnc in {ok, nok}); -- CNC: CNC: guard lock released after the cycle
INVAR cmd = c257 -> (CONV = C3_x & !(moving)); -- BELT: belt starts
INVAR cmd = c258 -> (!(CONV = C3_x) & moving); -- BELT: belt stops
INVAR cmd = c259 -> (moving & !(beltEntry = none) & beltMid = none); -- BELT: part moves from the entry
INVAR cmd = c260 -> (moving & !(beltMid = none) & beltExit = none); -- BELT: part reaches the end stop
INVAR cmd = c261 -> (inPresent & !(inParts)); -- OP: operator removes the empty input pallet
INVAR cmd = c262 -> !(inPresent); -- OP: operator places a full input pallet
INVAR cmd = c263 -> (R2 in {E7_0, E7_1, E7_2, E7_x} & outPresent); -- OP: operator takes the full output pallet away
INVAR cmd = c264 -> !(outPresent); -- OP: operator places an empty output pallet
INVAR cmd = c265 -> QH; -- OP: rung: tool and offsets checked -> quality hold released
-- the supervisor reacts at once: while one of its automatic transitions is enabled, nothing else moves
DEFINE urgent := (SUP = I_x) | ((SUP = X1_x & CAM_FAULT)) | ((SUP = X1_x & (mismatches in {1, 2, 3} & !(CAM_FAULT)))) | ((SUP = X2_x & (mismatches = 3 | CAM_FAULT))) | ((SUP = X2_x & (mismatches = 0 & !((mismatches = 3 | CAM_FAULT)))));
INVAR urgent -> cmd in {c246, c247, c248, c249, c250};
-- properties (M.PROPERTIES)
-- P1: No robot is at the conveyor while the belt moves
INVARSPEC NAME P1 := !urgent -> !(((R1 = B7_3 | R2 = E2_0) & moving));
-- P2: CYCLE START only with the door closed and the guard locked
SPEC NAME P2 := AG (!(R1 in {B6_1}) -> AX ((R1 in {B6_1}) -> (door = closed & lock)));
-- P3: Robot 1 is inside the CNC only with the door open and the spindle stopped
INVARSPEC NAME P3 := !urgent -> !((R1 in {B4_0, B4_1, B4_2} & (!(door = open) | run)));
-- P4: The door is opened only after the cycle, with the guard lock released
SPEC NAME P4 := AG (!(R1 in {B3_0}) -> AX ((R1 in {B3_0}) -> (!(run) & !(lock))));
-- P5: A part is placed on the conveyor only at a free entry of a stopped belt
SPEC NAME P5 := AG (!(R1 in {B7_3}) -> AX ((R1 in {B7_3}) -> (beltEntry = none & !(moving))));
-- P6: Robot 2 places a part only on an output pallet that is in place and not full
SPEC NAME P6 := AG (!(R2 in {E5_3}) -> AX ((R2 in {E5_3}) -> (outPresent & outCount in {0, 1})));
-- P7: An undersized part never reaches the output pallet
SPEC NAME P7 := AG (!(R2 in {E5_3}) -> AX ((R2 in {E5_3}) -> !(r2S = nok)));
-- P8: No CYCLE START during a quality hold
SPEC NAME P8 := AG (!(R1 in {B6_1}) -> AX ((R1 in {B6_1}) -> !(QH)));
-- P9: Three mismatches in the window always stop the line
INVARSPEC NAME P9 := !urgent -> !((mismatches = 3 & !((SUP = X3_x | SUP = X4_x))));
-- P10: A camera fault always stops the line
INVARSPEC NAME P10 := !urgent -> !((CAM_FAULT & !((SUP = X3_x | SUP = X4_x))));
-- L1: A new CNC cycle can always be started again
SPEC NAME L1 := AG EF (R1 = B6_1);
-- L2: Robot 2 can always deliver a part again
SPEC NAME L2 := AG EF (R2 = E5_3);
-- L3: After any stop the supervisor can return to NORMAL
SPEC NAME L3 := AG EF (SUP = X1_x);
-- every state of every machine can be reached
SPEC NAME reach_R1_B0 := EF (R1 in {B0_0, B0_x});
SPEC NAME reach_R1_B1 := EF (R1 in {B1_0, B1_1, B1_x});
SPEC NAME reach_R1_B2 := EF (R1 in {B2_0, B2_x});
SPEC NAME reach_R1_B3 := EF (R1 in {B3_0, B3_x});
SPEC NAME reach_R1_B4 := EF (R1 in {B4_0, B4_1, B4_2, B4_x});
SPEC NAME reach_R1_B5 := EF (R1 in {B5_0, B5_1, B5_x});
SPEC NAME reach_R1_B6 := EF (R1 in {B6_0, B6_1, B6_x});
SPEC NAME reach_R1_B7 := EF (R1 in {B7_0, B7_1, B7_2, B7_3, B7_4, B7_x});
SPEC NAME reach_R1_W1 := EF (R1 in {W1_0, W1_x});
SPEC NAME reach_R1_H := EF (R1 in {H_0, H_x});
SPEC NAME reach_R1_F := EF (R1 in {F_x});
SPEC NAME reach_CONV_C1 := EF (CONV in {C1_x});
SPEC NAME reach_CONV_C2 := EF (CONV in {C2_1, C2_2, C2_x});
SPEC NAME reach_CONV_C3 := EF (CONV in {C3_x});
SPEC NAME reach_CONV_C4 := EF (CONV in {C4_x});
SPEC NAME reach_CONV_C5 := EF (CONV in {C5_1, C5_x});
SPEC NAME reach_CONV_H := EF (CONV in {H_x});
SPEC NAME reach_CONV_F := EF (CONV in {F_x});
SPEC NAME reach_R2_E0 := EF (R2 in {E0_0, E0_1, E0_2, E0_3, E0_x});
SPEC NAME reach_R2_E1 := EF (R2 in {E1_0, E1_x});
SPEC NAME reach_R2_E2 := EF (R2 in {E2_0, E2_1, E2_x});
SPEC NAME reach_R2_E3 := EF (R2 in {E3_0, E3_1, E3_x});
SPEC NAME reach_R2_E4 := EF (R2 in {E4_0, E4_x});
SPEC NAME reach_R2_E5 := EF (R2 in {E5_1, E5_2, E5_3, E5_x});
SPEC NAME reach_R2_E6 := EF (R2 in {E6_0, E6_1, E6_x});
SPEC NAME reach_R2_E7 := EF (R2 in {E7_0, E7_1, E7_2, E7_x});
SPEC NAME reach_R2_H := EF (R2 in {H_0, H_x});
SPEC NAME reach_R2_F := EF (R2 in {F_x});
SPEC NAME reach_SUP_X1 := EF (SUP in {X1_x});
SPEC NAME reach_SUP_X2 := EF (SUP in {X2_x});
SPEC NAME reach_SUP_X3 := EF (SUP in {X3_x});
SPEC NAME reach_SUP_X4 := EF (SUP in {X4_x});
