    cmd = c247 & g247 & !urgent : Q_E4_0;
    cmd = c248 & g248 & !urgent : none;
    cmd = c249 & g249 & !urgent : E5_0;
    cmd = c250 & g250 & !urgent : none;
    cmd = c251 & g251 & !urgent : E5_2;
