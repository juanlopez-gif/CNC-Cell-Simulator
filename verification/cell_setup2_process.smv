    cmd = c124 & g124 & !urgent : FALSE;
    cmd = c132 & g132 & !urgent : FALSE;
    TRUE : partPlaced;
  esac;
  next(pickAllowed) := case
    cmd = c104 & g104 & !urgent : FALSE;
