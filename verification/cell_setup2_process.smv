    cmd = c185 & g185 & !urgent : TRUE;
    cmd = c283 & g283 & !urgent : FALSE;
    TRUE : QH;
  esac;
  next(mismatches) := case
    cmd = c271 & g271 & !urgent : 0;
    TRUE : mismatches;
  esac;
  next(consecNok) := case
    cmd = c170 & g170 & !urgent : 0;
