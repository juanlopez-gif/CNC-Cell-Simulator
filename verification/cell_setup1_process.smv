-- properties (M.PROPERTIES)
-- P1: No robot is at the conveyor while the belt moves
INVARSPEC NAME P1 := !urgent -> !(((R1 = A4_3 | R2 = D2_0) & moving));
-- P2: CYCLE START only with the door closed and the guard locked
INVARSPEC NAME P2 := ((next(R1) != R1 & (next(R1) in {A8_0}))) -> next((door = closed & lock));
-- P3: Robot 1 is inside the CNC only with the door open and the spindle stopped
INVARSPEC NAME P3 := !urgent -> !((R1 in {A3_0, A6_0} & (!(door = open) | run)));
-- P4: The door is opened only after the cycle, with the guard lock released
INVARSPEC NAME P4 := ((next(R1) != R1 & (next(R1) in {A2_0}))) -> next((!(run) & !(lock)));
-- P5: A part is placed on the conveyor only at a free entry of a stopped belt
INVARSPEC NAME P5 := ((next(R1) != R1 & (next(R1) in {A4_3}))) -> next((beltEntry = none & !(moving)));
-- P6: Robot 2 places a part only on an output pallet that is in place and not full
INVARSPEC NAME P6 := ((next(R2) != R2 & (next(R2) in {D3_1}))) -> next((outPresent & outCount in {0, 1}));
-- P9: Three mismatches in the window always stop the line
INVARSPEC NAME P9 := !urgent -> !((mismatches = 3 & !((SUP = X3_x | SUP = X4_x))));
-- P10: A camera fault always stops the line
INVARSPEC NAME P10 := !urgent -> !((CAM_FAULT & !((SUP = X3_x | SUP = X4_x))));
-- L1: A new CNC cycle can always be started again
SPEC NAME L1 := AG EF (R1 = A8_0);
-- L2: Robot 2 can always deliver a part again
SPEC NAME L2 := AG EF (R2 = D3_1);
-- L3: After any stop the supervisor can return to NORMAL
SPEC NAME L3 := AG EF (SUP = X1_x);
-- no deadlock: in every reachable state some command other than idle can be taken
INVARSPEC NAME no_deadlock := enabled;
-- every state of every machine: true if it can never be reached (as invariants: much faster than EF)
INVARSPEC NAME unreachable_R1_A0 := !(R1 in {A0_0, A0_x});
INVARSPEC NAME unreachable_R1_A1 := !(R1 in {A1_0, A1_x});
INVARSPEC NAME unreachable_R1_A2 := !(R1 in {A2_0, A2_x});
INVARSPEC NAME unreachable_R1_A3 := !(R1 in {A3_0, A3_x});
INVARSPEC NAME unreachable_R1_A4 := !(R1 in {A4_0, A4_1, A4_2, A4_3, A4_4, A4_x});
INVARSPEC NAME unreachable_R1_A5 := !(R1 in {A5_0, A5_1, A5_x});
INVARSPEC NAME unreachable_R1_A6 := !(R1 in {A6_0, A6_x});
INVARSPEC NAME unreachable_R1_A7 := !(R1 in {A7_0, A7_1, A7_x});
INVARSPEC NAME unreachable_R1_A8 := !(R1 in {A8_0, A8_x});
INVARSPEC NAME unreachable_R1_W1 := !(R1 in {W1_0, W1_x});
INVARSPEC NAME unreachable_R1_H := !(R1 in {H_0, H_x});
INVARSPEC NAME unreachable_R1_F := !(R1 in {F_x});
INVARSPEC NAME unreachable_CONV_C1 := !(CONV in {C1_x});
INVARSPEC NAME unreachable_CONV_C2 := !(CONV in {C2_1, C2_2, C2_x});
INVARSPEC NAME unreachable_CONV_C3 := !(CONV in {C3_x});
INVARSPEC NAME unreachable_CONV_C4 := !(CONV in {C4_x});
INVARSPEC NAME unreachable_CONV_C5 := !(CONV in {C5_1, C5_x});
INVARSPEC NAME unreachable_CONV_H := !(CONV in {H_x});
INVARSPEC NAME unreachable_CONV_F := !(CONV in {F_x});
INVARSPEC NAME unreachable_R2_D0 := !(R2 in {D0_0, D0_1, D0_x});
INVARSPEC NAME unreachable_R2_D1 := !(R2 in {D1_0, D1_x});
INVARSPEC NAME unreachable_R2_D2 := !(R2 in {D2_0, D2_1, D2_x});
INVARSPEC NAME unreachable_R2_D3 := !(R2 in {D3_0, D3_1, D3_x});
INVARSPEC NAME unreachable_R2_D4 := !(R2 in {D4_0, D4_1, D4_2, D4_x});
INVARSPEC NAME unreachable_R2_H := !(R2 in {H_0, H_x});
INVARSPEC NAME unreachable_R2_F := !(R2 in {F_x});
INVARSPEC NAME unreachable_SUP_X1 := !(SUP in {X1_x});
INVARSPEC NAME unreachable_SUP_X2 := !(SUP in {X2_x});
INVARSPEC NAME unreachable_SUP_X3 := !(SUP in {X3_x});
INVARSPEC NAME unreachable_SUP_X4 := !(SUP in {X4_x});
