  g219 := (R2 = F_x & (R2_res = Q_D3_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & (!(outCount = 2) & (r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0})))); -- R2: F: cleared, repeat Q_D3@0
