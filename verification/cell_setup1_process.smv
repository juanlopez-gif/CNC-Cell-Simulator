  g207 := (R2 = F_x & (R2_res = D1_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & !((r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0})))); -- R2: F: cleared, repeat D1@0
  g208 := (R2 = F_x & (R2_res = D1_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & (r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0}))); -- R2: F: cleared, repeat D1@0
