INVAR cmd = c192 -> (R2 = F_x & (R2_res = D1_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & (r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0}))); -- R2: F: cleared, repeat D1@0
INVAR cmd = c193 -> (R2 = F_x & (R2_res = D1_0 & ((SUP = X3_x | SUP = X4_x) | CAM_FAULT))); -- R2: F: cleared during a line stop
INVAR cmd = c194 -> (R2 = F_x & (R2_res = D2_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT)))); -- R2: F: cleared, repeat D2@0
INVAR cmd = c195 -> (R2 = F_x & (R2_res = D2_0 & ((SUP = X3_x | SUP = X4_x) | CAM_FAULT))); -- R2: F: cleared during a line stop
INVAR cmd = c196 -> (R2 = F_x & (R2_res = D2_1 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT)))); -- R2: F: cleared, repeat D2@1
INVAR cmd = c197 -> (R2 = F_x & (R2_res = D2_1 & ((SUP = X3_x | SUP = X4_x) | CAM_FAULT))); -- R2: F: cleared during a line stop
INVAR cmd = c198 -> (R2 = F_x & (R2_res = D3_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT)))); -- R2: F: cleared, repeat D3@0
INVAR cmd = c199 -> (R2 = F_x & (R2_res = D3_0 & ((SUP = X3_x | SUP = X4_x) | CAM_FAULT))); -- R2: F: cleared during a line stop
INVAR cmd = c200 -> (R2 = F_x & (R2_res = Q_D3_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & (outCount = 2 & !((r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0}))))); -- R2: F: cleared, repeat Q_D3@0
INVAR cmd = c201 -> (R2 = F_x & (R2_res = Q_D3_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & (outCount = 2 & (r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0})))); -- R2: F: cleared, repeat Q_D3@0
INVAR cmd = c202 -> (R2 = F_x & (R2_res = Q_D3_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & (!(outCount = 2) & !((r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0}))))); -- R2: F: cleared, repeat Q_D3@0
INVAR cmd = c203 -> (R2 = F_x & (R2_res = Q_D3_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & (!(outCount = 2) & (r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0})))); -- R2: F: cleared, repeat Q_D3@0
INVAR cmd = c204 -> (R2 = F_x & (R2_res = Q_D3_0 & ((SUP = X3_x | SUP = X4_x) | CAM_FAULT))); -- R2: F: cleared during a line stop
INVAR cmd = c205 -> (R2 = F_x & (R2_res = D4_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & !((r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0})))); -- R2: F: cleared, repeat D4@0
INVAR cmd = c206 -> (R2 = F_x & (R2_res = D4_0 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT))) & (r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0}))); -- R2: F: cleared, repeat D4@0
INVAR cmd = c207 -> (R2 = F_x & (R2_res = D4_0 & ((SUP = X3_x | SUP = X4_x) | CAM_FAULT))); -- R2: F: cleared during a line stop
INVAR cmd = c208 -> (R2 = F_x & (R2_res = D4_2 & !(((SUP = X3_x | SUP = X4_x) | CAM_FAULT)))); -- R2: F: cleared, repeat D4@2
INVAR cmd = c209 -> (R2 = F_x & (R2_res = D4_2 & ((SUP = X3_x | SUP = X4_x) | CAM_FAULT))); -- R2: F: cleared during a line stop
INVAR cmd = c210 -> SUP = I_x; -- SUP: I -> X1
INVAR cmd = c211 -> (SUP = X1_x & CAM_FAULT); -- SUP: X1 -> X3
INVAR cmd = c212 -> (SUP = X1_x & (mismatches in {1, 2, 3} & !(CAM_FAULT))); -- SUP: X1 -> X2
INVAR cmd = c213 -> (SUP = X2_x & (mismatches = 3 | CAM_FAULT)); -- SUP: X2 -> X3
INVAR cmd = c214 -> (SUP = X2_x & (mismatches = 0 & !((mismatches = 3 | CAM_FAULT)))); -- SUP: X2 -> X1
INVAR cmd = c215 -> (SUP = X3_x & ((r1Home & !(R1 in {A0_0, A1_0, A2_0, A3_0, A4_0, A4_3, A5_1, A6_0, A7_0, A7_1, A8_0, W1_0, H_0})) & (r2Home & !(R2 in {D0_0, D1_0, D2_0, D3_1, D4_0, H_0})) & !(moving))); -- SUP: X3 -> X4 [HMI.verify]
INVAR cmd = c216 -> SUP = X4_x; -- SUP: X4 -> X4 [VERIFY.fail]
INVAR cmd = c217 -> SUP = X4_x; -- SUP: X4 -> X1 [VERIFY.pass, HMI.reset]
INVAR cmd = c218 -> (run & cnc = raw); -- CNC: CNC: cycle complete
INVAR cmd = c219 -> (run & !(cnc = raw)); -- CNC: CNC: cycle complete (empty)
INVAR cmd = c220 -> (!(run) & lock & cnc = fin); -- CNC: CNC: guard lock released after the cycle
INVAR cmd = c221 -> (CONV = C3_x & !(moving)); -- BELT: belt starts
INVAR cmd = c222 -> (!(CONV = C3_x) & moving); -- BELT: belt stops
INVAR cmd = c223 -> (moving & !(beltEntry = none) & beltMid = none); -- BELT: part moves from the entry
INVAR cmd = c224 -> (moving & !(beltMid = none) & beltExit = none); -- BELT: part reaches the end stop
INVAR cmd = c225 -> (inPresent & !(inParts)); -- OP: operator removes the empty input pallet
INVAR cmd = c226 -> !(inPresent); -- OP: operator places a full input pallet
INVAR cmd = c227 -> (R2 in {D4_0, D4_1, D4_2, D4_x} & outPresent); -- OP: operator takes the full output pallet away
INVAR cmd = c228 -> !(outPresent); -- OP: operator places an empty output pallet
-- the supervisor reacts at once: while one of its automatic transitions is enabled, nothing else moves
DEFINE urgent := (SUP = I_x) | ((SUP = X1_x & CAM_FAULT)) | ((SUP = X1_x & (mismatches in {1, 2, 3} & !(CAM_FAULT)))) | ((SUP = X2_x & (mismatches = 3 | CAM_FAULT))) | ((SUP = X2_x & (mismatches = 0 & !((mismatches = 3 | CAM_FAULT)))));
INVAR urgent -> cmd in {c210, c211, c212, c213, c214};
-- properties (M.PROPERTIES)
-- P1: No robot is at the conveyor while the belt moves
INVARSPEC NAME P1 := !urgent -> !(((R1 = A4_3 | R2 = D2_0) & moving));
-- P2: CYCLE START only with the door closed and the guard locked
SPEC NAME P2 := AG (!(R1 in {A8_0}) -> AX ((R1 in {A8_0}) -> (door = closed & lock)));
-- P3: Robot 1 is inside the CNC only with the door open and the spindle stopped
INVARSPEC NAME P3 := !urgent -> !((R1 in {A3_0, A6_0} & (!(door = open) | run)));
-- P4: The door is opened only after the cycle, with the guard lock released
SPEC NAME P4 := AG (!(R1 in {A2_0}) -> AX ((R1 in {A2_0}) -> (!(run) & !(lock))));
-- P5: A part is placed on the conveyor only at a free entry of a stopped belt
SPEC NAME P5 := AG (!(R1 in {A4_3}) -> AX ((R1 in {A4_3}) -> (beltEntry = none & !(moving))));
-- P6: Robot 2 places a part only on an output pallet that is in place and not full
SPEC NAME P6 := AG (!(R2 in {D3_1}) -> AX ((R2 in {D3_1}) -> (outPresent & outCount in {0, 1})));
-- P9: Three mismatches in the window always stop the line
INVARSPEC NAME P9 := !urgent -> !((mismatches = 3 & !((SUP = X3_x | SUP = X4_x))));
-- P10: A camera fault always stops the line
INVARSPEC NAME P10 := !urgent -> !((CAM_FAULT & !((SUP = X3_x | SUP = X4_x))));
-- L1: A new CNC cycle can always be started again
SPEC NAME L1 := AG EF (R1 = A8_0);
-- L2: Robot 2 can always deliver a part again
SPEC NAME L2 := AG EF (R2 = D3_1);
-- L3: After any stop the supervisor can return to NORMAL
SPEC NAME L3 := AG EF (SUP = X1_x);
-- every state of every machine can be reached
SPEC NAME reach_R1_A0 := EF (R1 in {A0_0, A0_x});
SPEC NAME reach_R1_A1 := EF (R1 in {A1_0, A1_x});
SPEC NAME reach_R1_A2 := EF (R1 in {A2_0, A2_x});
SPEC NAME reach_R1_A3 := EF (R1 in {A3_0, A3_x});
SPEC NAME reach_R1_A4 := EF (R1 in {A4_0, A4_1, A4_2, A4_3, A4_4, A4_x});
SPEC NAME reach_R1_A5 := EF (R1 in {A5_0, A5_1, A5_x});
SPEC NAME reach_R1_A6 := EF (R1 in {A6_0, A6_x});
SPEC NAME reach_R1_A7 := EF (R1 in {A7_0, A7_1, A7_x});
SPEC NAME reach_R1_A8 := EF (R1 in {A8_0, A8_x});
SPEC NAME reach_R1_W1 := EF (R1 in {W1_0, W1_x});
SPEC NAME reach_R1_H := EF (R1 in {H_0, H_x});
SPEC NAME reach_R1_F := EF (R1 in {F_x});
SPEC NAME reach_CONV_C1 := EF (CONV in {C1_x});
SPEC NAME reach_CONV_C2 := EF (CONV in {C2_1, C2_2, C2_x});
SPEC NAME reach_CONV_C3 := EF (CONV in {C3_x});
SPEC NAME reach_CONV_C4 := EF (CONV in {C4_x});
SPEC NAME reach_CONV_C5 := EF (CONV in {C5_1, C5_x});
SPEC NAME reach_CONV_H := EF (CONV in {H_x});
SPEC NAME reach_CONV_F := EF (CONV in {F_x});
SPEC NAME reach_R2_D0 := EF (R2 in {D0_0, D0_1, D0_x});
SPEC NAME reach_R2_D1 := EF (R2 in {D1_0, D1_x});
SPEC NAME reach_R2_D2 := EF (R2 in {D2_0, D2_1, D2_x});
SPEC NAME reach_R2_D3 := EF (R2 in {D3_0, D3_1, D3_x});
SPEC NAME reach_R2_D4 := EF (R2 in {D4_0, D4_1, D4_2, D4_x});
SPEC NAME reach_R2_H := EF (R2 in {H_0, H_x});
SPEC NAME reach_R2_F := EF (R2 in {F_x});
SPEC NAME reach_SUP_X1 := EF (SUP in {X1_x});
SPEC NAME reach_SUP_X2 := EF (SUP in {X2_x});
SPEC NAME reach_SUP_X3 := EF (SUP in {X3_x});
SPEC NAME reach_SUP_X4 := EF (SUP in {X4_x});
