  VAR_GLOBAL (* internal *)
    ZS_32 : BOOL; (* ZS-32, debounced *)
    GR_21A : BOOL; (* GR-21A, debounced *)
    ZS_33 : BOOL; (* ZS-33, debounced *)
    ZS_31 : BOOL; (* ZS-31, debounced *)
    PS_36 : BOOL; (* PS-36, debounced *)
    GR_21B : BOOL; (* GR-21B, debounced *)
    ZS_34 : BOOL; (* ZS-34, debounced *)
    ZS_35 : BOOL; (* ZS-35, debounced *)
    ENC_43 : BOOL; (* ENC-43, debounced *)
    PE_42 : BOOL; (* PE-42, debounced *)
    GAUGE_due : BOOL; (* PLC timer (M.PLC.timers) *)
    GAUGE_due_restart : BOOL; (* restart GAUGE.due *)
    GR_51 : BOOL; (* GR-51, debounced *)
    PE_65 : BOOL; (* PE-65, latched on the rising edge *)
    PX_11 : BOOL; (* PX-11, debounced *)
    PE_41 : BOOL; (* PE-41, debounced *)
    PX_52 : BOOL; (* PX-52, debounced *)
    PX_64 : BOOL; (* PX-64, debounced *)
    E_HMI_clear : BOOL; (* rising edge of HMI.clear in this scan *)
    L_HMI_verify : BOOL; (* HMI.verify, latched until a transition reads it *)
    L_VERIFY_pass : BOOL; (* VERIFY.pass, latched until a transition reads it *)
    L_HMI_reset : BOOL; (* HMI.reset, latched until a transition reads it *)
    L_VERIFY_fail : BOOL; (* VERIFY.fail, latched until a transition reads it *)
    L_HMI_release : BOOL; (* HMI.release, latched until a transition reads it *)
    partPlaced : BOOL; (* partPlaced *)
    pickAllowed : BOOL; (* pickAllowed *)
    partPicked : BOOL; (* partPicked *)
    mismatches : INT; (* mismatches *)
    CAM_FAULT : BOOL; (* CAM_FAULT *)
    COMM_LOST : BOOL; (* no heartbeat for M.PLC.heartbeatTimeout *)
    mmPending : INT; (* mismatch events to add to the window *)
    mmClear : BOOL; (* clear the mismatch window *)
  END_VAR
  VAR_GLOBAL RETAIN (* kept over a cold restart (M.PLC.retain) *)
    consecNok : INT; (* consecNok *)
    QH : BOOL; (* QH *)
  END_VAR
  RESOURCE Res0 ON PLC
    TASK MainTask (INTERVAL := T#10ms, PRIORITY := 0);
    PROGRAM Main WITH MainTask : CellMain;
  END_RESOURCE
END_CONFIGURATION
