        ELSIF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 9; hStep := 0; R1_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN (* B7 step 3: check CP-2 *)
        IF ph = 0 THEN
          IF NOT (GR_21B) THEN stp := 3; ELSE tries := 0; ph := 2; END_IF;
        END_IF;
        IF ph = 2 AND NOT moved AND NOT R1_CP_2_Done THEN proxL := PE_41; R1_CP_2_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND R1_CP_2_Done THEN
          R1_CP_2_Trig := FALSE;
          IF NOT R1_CP_2_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 9; hStep := 2; R1_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = R1_CP_2_Cam THEN res_CP_2 := proxL; ph := 5;
          ELSE res_CP_2 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT R1_CP_2_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          IF NOT (NOT (res_CP_2)) THEN fRes := R1_state; R1_fault := 903; R1_Start := FALSE; R1_CP_1_Trig := FALSE; R1_CP_2_Trig := FALSE; clr_HMI_clear := FALSE; R1_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSE stp := 3; ph := 0; END_IF;
        END_IF;
      END_IF;
      IF stp = 3 AND NOT moved THEN (* B7 step 4: job R1.placeConvB *)
        IF ph = 0 THEN
          IF NOT (GR_21B) THEN stp := 4;
          ELSIF NOT COMM_LOST AND NOT R1_Done THEN R1_JobNo := 11; R1_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R1_state; R1_fault := 934; R1_Start := FALSE; R1_CP_1_Trig := FALSE; R1_CP_2_Trig := FALSE; clr_HMI_clear := FALSE; R1_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R1_Done THEN
            R1_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R1_Done THEN ph := 0; stp := 4;
        END_IF;
      END_IF;
      IF stp = 4 AND NOT moved THEN (* B7 step 5: check CP-2 *)
        IF ph = 0 THEN
          tries := 0; ph := 1;
        END_IF;
        IF ph = 1 AND NOT moved THEN tStep(IN := TRUE, PT := T#500ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* settle *)
        IF ph = 2 AND NOT moved AND NOT R1_CP_2_Done THEN proxL := PE_41; R1_CP_2_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND R1_CP_2_Done THEN
          R1_CP_2_Trig := FALSE;
          IF NOT R1_CP_2_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 9; hStep := 4; R1_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = R1_CP_2_Cam THEN res_CP_2 := proxL; ph := 5;
          ELSE res_CP_2 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT R1_CP_2_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          stp := 5; ph := 0;
        END_IF;
      END_IF;
      IF stp = 5 AND NOT moved THEN (* B7 step 6: set *)
        IF res_CP_2 THEN partPlaced := TRUE; END_IF;
        stp := 6;
      END_IF;
      IF stp = 6 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (res_CP_2 AND R1_clearConv) THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 2; hStep := 0; R1_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R1_state := 2; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to B1 *)
        ELSIF tWait.ET >= T#1000ms THEN fRes := R1_state; R1_fault := 999; R1_Start := FALSE; R1_CP_1_Trig := FALSE; R1_CP_2_Trig := FALSE; clr_HMI_clear := FALSE; R1_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    10: (* W1 WAIT FOR INPUT PALLET - waiting *)
      IF stp = 0 AND NOT moved THEN (* W1 step 1: job R1.park *)
        IF ph = 0 THEN
          IF NOT (NOT (R1_home)) THEN stp := 1;
          ELSIF NOT COMM_LOST AND NOT R1_Done THEN R1_JobNo := 2; R1_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R1_state; R1_fault := 1031; R1_Start := FALSE; R1_CP_1_Trig := FALSE; R1_CP_2_Trig := FALSE; clr_HMI_clear := FALSE; R1_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R1_Done THEN
            R1_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R1_Done THEN ph := 0; stp := 1;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF HMI_loaded THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 2; hStep := 0; R1_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R1_state := 2; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to B1 *)
        ELSIF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 10; hStep := 0; R1_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    98: (* H HOLD: LINE STOP: finish the step, park, wait for the reset *)
      IF stp = 0 AND NOT moved THEN (* H step 1: job R1.park *)
        IF ph = 0 THEN
          IF NOT COMM_LOST AND NOT R1_Done THEN R1_JobNo := 2; R1_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R1_state; R1_fault := 9831; R1_Start := FALSE; R1_CP_1_Trig := FALSE; R1_CP_2_Trig := FALSE; clr_HMI_clear := FALSE; R1_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R1_Done THEN
            R1_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R1_Done THEN ph := 0; stp := 1;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved AND NOT ((((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT)) THEN R1_state := hRes; stp := hStep; ph := 0; fresh := TRUE; moved := TRUE; END_IF;
    99: (* F FAULT: From any state: timeout or a missing confirmation - red light; the state is entered again *)
      IF clr_HMI_clear THEN clr_HMI_clear := FALSE; R1_fault := 0; IF fRes = 98 THEN R1_state := 98; ELSIF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := fRes; hStep := 0; R1_state := 98; ELSE R1_state := fRes; END_IF; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF;
  END_CASE;
  CASE R1_state OF (* choice states *)
    8: IF GR_21B THEN R1_state := 9; ELSE R1_state := 2; END_IF; (* Q_B6: GR-21B *)
  END_CASE;
END_FUNCTION_BLOCK

(* States of CONV (CONV_state): 0=initial H=98 F=99 C1=1 C2=2 C3=3 C4=4 C5=5 *)
(* Fault codes of CONV (CONV_fault):
   203 C2: missing confirmation at CP-3: !CP-3
   299 C2: missing confirmation: R1.clearConv & R2.clearConv & !CP-3
   350 C3: no ENC-43 pulses within 1 s
   351 C3: no PE-42 within 15 s
   499 C4: missing confirmation: !ENC-43
   502 C5: missing confirmation at CP-3: CP-3
*)
FUNCTION_BLOCK FB_CONV
  VAR_EXTERNAL
    R1_state : INT;
    R1_fault : INT;
    CONV_state : INT;
    CONV_fault : INT;
    R2_state : INT;
    R2_fault : INT;
    SUP_state : INT;
    R1_JobNo : INT;
    R1_Start : BOOL;
    R1_Done : BOOL;
    R1_CP_1_Trig : BOOL;
    R1_CP_1_Done : BOOL;
    R1_CP_1_Valid : BOOL;
    R1_CP_1_Cam : BOOL;
    R1_CP_1_Also : BOOL;
    R1_CP_2_Trig : BOOL;
    R1_CP_2_Done : BOOL;
    R1_CP_2_Valid : BOOL;
    R1_CP_2_Cam : BOOL;
    CONV_CP_2_Trig : BOOL;
    CONV_CP_2_Done : BOOL;
    CONV_CP_2_Valid : BOOL;
    CONV_CP_2_Cam : BOOL;
    CONV_CP_3_Trig : BOOL;
    CONV_CP_3_Done : BOOL;
    CONV_CP_3_Valid : BOOL;
    CONV_CP_3_Cam : BOOL;
    R2_JobNo : INT;
    R2_Start : BOOL;
    R2_Done : BOOL;
    R2_CP_4_Trig : BOOL;
    R2_CP_4_Done : BOOL;
    R2_CP_4_Valid : BOOL;
    R2_CP_4_Cam : BOOL;
    R2_CP_5_Trig : BOOL;
    R2_CP_5_Done : BOOL;
    R2_CP_5_Valid : BOOL;
    R2_CP_5_Cam : BOOL;
    R2_CP_3_Trig : BOOL;
    R2_CP_3_Done : BOOL;
    R2_CP_3_Valid : BOOL;
    R2_CP_3_Cam : BOOL;
    HMI_auto : BOOL;
    R1_home : BOOL;
    CNC_ready : BOOL;
    ZS_32_in : BOOL;
    ZS_32 : BOOL;
    GR_21A_in : BOOL;
    GR_21A : BOOL;
    CNC_done : BOOL;
    ZS_33_in : BOOL;
    ZS_33 : BOOL;
    CNC_empty : BOOL;
    ZS_31_in : BOOL;
    ZS_31 : BOOL;
    PS_36_in : BOOL;
    PS_36 : BOOL;
    GR_21B_in : BOOL;
    GR_21B : BOOL;
    ZS_34_in : BOOL;
    ZS_34 : BOOL;
    ZS_35_in : BOOL;
    ZS_35 : BOOL;
    R1_clearCnc : BOOL;
    CNC_run : BOOL;
    ENC_43_in : BOOL;
    ENC_43 : BOOL;
    R1_clearConv : BOOL;
    HMI_loaded : BOOL;
    R2_clearConv : BOOL;
    PE_42_in : BOOL;
    PE_42 : BOOL;
    ROI_C : BOOL;
    R2_home : BOOL;
    GAUGE_zeroed : BOOL;
    GAUGE_due : BOOL;
    GAUGE_due_restart : BOOL;
    GR_51_in : BOOL;
    GR_51 : BOOL;
    R2_clearGauge : BOOL;
    GAUGE_valid : BOOL;
    GAUGE_ok : BOOL;
    CAM_2_slot : BOOL;
    outCount : INT;
    PE_65_in : BOOL;
    PE_65 : BOOL;
    PX_11_in : BOOL;
    PX_11 : BOOL;
    PE_41_in : BOOL;
    PE_41 : BOOL;
    PX_52_in : BOOL;
    PX_52 : BOOL;
    PX_64_in : BOOL;
    PX_64 : BOOL;
    HMI_clear : BOOL;
    E_HMI_clear : BOOL;
    HMI_verify : BOOL;
    L_HMI_verify : BOOL;
    VERIFY_pass : BOOL;
    L_VERIFY_pass : BOOL;
    HMI_reset : BOOL;
    L_HMI_reset : BOOL;
    VERIFY_fail : BOOL;
    L_VERIFY_fail : BOOL;
    HMI_release : BOOL;
    L_HMI_release : BOOL;
    HB : BOOL;
    partPlaced : BOOL;
    pickAllowed : BOOL;
    partPicked : BOOL;
    consecNok : INT;
    QH : BOOL;
    mismatches : INT;
    CAM_FAULT : BOOL;
    COMM_LOST : BOOL;
    mmPending : INT;
    mmClear : BOOL;
    BELT_motor : BOOL;
    LT_53 : BOOL;
    LT_01_red : BOOL;
    LT_01_amber : BOOL;
    LT_01_green : BOOL;
    V_partPlaced : BOOL;
    V_pickAllowed : BOOL;
    V_partPicked : BOOL;
    V_consecNok : INT;
    V_QH : BOOL;
    V_mismatches : INT;
    V_CAM_FAULT : BOOL;
  END_VAR
  VAR
    stp : INT := 0;        (* step of the state; = number of steps once they are done *)
    ph : INT := 0;         (* phase of the running step *)
    hRes : INT := 0;       (* state to resume after H *)
    hStep : INT := 0;      (* step to resume after H (a check repeated after a camera fault) *)
    fRes : INT := 0;       (* state to enter again after F *)
    tries : INT := 0;      (* images taken by the running check *)
    proxL : BOOL;          (* proximity value latched with the camera trigger *)
    fresh : BOOL := TRUE;  (* a state was entered: reset the timers *)
    moved : BOOL;          (* this call changed the state: nothing else runs *)
    tWait : TON;           (* time since the steps of the state were done *)
    tStep : TON;           (* settle, re-trigger and repeat timer of a check *)
    tFor1 : TON;
    res_CP_2 : BOOL;  (* result of the last check CP-2 of this machine *)
    res_CP_3 : BOOL;  (* result of the last check CP-3 of this machine *)
    clr_HMI_clear : BOOL;  (* HMI.clear pressed while in F *)
  END_VAR
  (* State diagram: Conveyor *)
  IF fresh THEN tWait(IN := FALSE); tStep(IN := FALSE); tFor1(IN := FALSE); fresh := FALSE; END_IF;
  moved := FALSE;
  IF CONV_state = 99 AND E_HMI_clear THEN clr_HMI_clear := TRUE; END_IF;
  CASE CONV_state OF
    0: (* initial: Start-up: *)
      IF stp = 0 AND NOT moved THEN (* initial step 1: check CP-2 *)
        IF ph = 0 THEN
          tries := 0; ph := 2;
        END_IF;
        IF ph = 2 AND NOT moved AND NOT CONV_CP_2_Done THEN proxL := PE_41; CONV_CP_2_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND CONV_CP_2_Done THEN
          CONV_CP_2_Trig := FALSE;
          IF NOT CONV_CP_2_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 0; hStep := 0; CONV_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = CONV_CP_2_Cam THEN res_CP_2 := proxL; ph := 5;
          ELSE res_CP_2 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT CONV_CP_2_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          IF NOT (NOT (res_CP_2)) THEN
            ph := 6;
          ELSE
            stp := 1; ph := 0;
          END_IF;
        END_IF;
        IF ph = 6 AND NOT moved THEN tStep(IN := TRUE, PT := T#500ms); IF tStep.Q THEN tStep(IN := FALSE); tries := 0; ph := 2; END_IF; END_IF; (* repeat until !CP-2 *)
      END_IF;
      IF stp = 1 AND NOT moved THEN (* initial step 2: check CP-3 *)
        IF ph = 0 THEN
          tries := 0; ph := 2;
        END_IF;
        IF ph = 2 AND NOT moved AND NOT CONV_CP_3_Done THEN proxL := PE_42; CONV_CP_3_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND CONV_CP_3_Done THEN
          CONV_CP_3_Trig := FALSE;
          IF NOT CONV_CP_3_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 0; hStep := 1; CONV_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = CONV_CP_3_Cam THEN res_CP_3 := proxL; ph := 5;
          ELSE res_CP_3 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT CONV_CP_3_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          IF NOT (NOT (res_CP_3)) THEN
            ph := 6;
          ELSE
            stp := 2; ph := 0;
          END_IF;
        END_IF;
        IF ph = 6 AND NOT moved THEN tStep(IN := TRUE, PT := T#500ms); IF tStep.Q THEN tStep(IN := FALSE); tries := 0; ph := 2; END_IF; END_IF; (* repeat until !CP-3 *)
      END_IF;
      IF stp = 2 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (NOT (res_CP_2) AND NOT (res_CP_3)) THEN CONV_state := 1; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to C1 *)
        END_IF;
      END_IF;
    1: (* C1 EMPTY - STOPPED - waiting - not interrupted by a LINE STOP *)
      IF stp = 0 AND NOT moved THEN (* C1 step 1: set *)
        partPicked := FALSE; pickAllowed := FALSE;
        stp := 1;
      END_IF;
      IF stp = 1 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF partPlaced THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 2; hStep := 0; CONV_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE CONV_state := 2; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to C2 *)
        END_IF;
      END_IF;
    2: (* C2 PART AT ENTRY *)
      IF stp = 0 AND NOT moved THEN (* C2 step 1: set *)
        partPlaced := FALSE;
        stp := 1;
      END_IF;
      IF stp = 1 AND NOT moved THEN (* C2 step 2: await R1.clearConv & R2.clearConv *)
        IF (R1_clearConv AND R2_clearConv) THEN stp := 2;
        ELSIF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 2; hStep := 0; CONV_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN (* C2 step 3: check CP-3 *)
        IF ph = 0 THEN
          tries := 0; ph := 2;
        END_IF;
        IF ph = 2 AND NOT moved AND NOT CONV_CP_3_Done THEN proxL := PE_42; CONV_CP_3_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND CONV_CP_3_Done THEN
          CONV_CP_3_Trig := FALSE;
          IF NOT CONV_CP_3_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 2; hStep := 2; CONV_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = CONV_CP_3_Cam THEN res_CP_3 := proxL; ph := 5;
          ELSE res_CP_3 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT CONV_CP_3_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          IF NOT (NOT (res_CP_3)) THEN fRes := CONV_state; CONV_fault := 203; CONV_CP_2_Trig := FALSE; CONV_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; CONV_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSE stp := 3; ph := 0; END_IF;
        END_IF;
      END_IF;
      IF stp = 3 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (R1_clearConv AND R2_clearConv AND NOT (res_CP_3)) THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 3; hStep := 0; CONV_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE CONV_state := 3; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to C3 *)
        ELSIF tWait.ET >= T#1000ms THEN fRes := CONV_state; CONV_fault := 299; CONV_CP_2_Trig := FALSE; CONV_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; CONV_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    3: (* C3 TRANSPORTING - waiting - not interrupted by a LINE STOP *)
      IF stp = 0 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (PE_42 OR ROI_C) THEN CONV_state := 4; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to C4 *)
        ELSIF NOT (ENC_43) AND tWait.ET >= T#1000ms THEN fRes := CONV_state; CONV_fault := 350; CONV_CP_2_Trig := FALSE; CONV_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; CONV_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        ELSIF tWait.ET >= T#15000ms THEN fRes := CONV_state; CONV_fault := 351; CONV_CP_2_Trig := FALSE; CONV_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; CONV_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    4: (* C4 STOPPING *)
      IF stp = 0 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        tFor1(IN := NOT (ENC_43), PT := T#200ms);
        IF tFor1.Q THEN CONV_state := 5; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to C5 *)
        ELSIF tWait.ET >= T#1000ms THEN fRes := CONV_state; CONV_fault := 499; CONV_CP_2_Trig := FALSE; CONV_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; CONV_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    5: (* C5 PART AT EXIT - READY TO PICK - waiting - not interrupted by a LINE STOP *)
      IF stp = 0 AND NOT moved THEN (* C5 step 1: set *)
        pickAllowed := FALSE;
        stp := 1;
      END_IF;
      IF stp = 1 AND NOT moved THEN (* C5 step 2: check CP-3 *)
        IF ph = 0 THEN
          tries := 0; ph := 1;
        END_IF;
        IF ph = 1 AND NOT moved THEN tStep(IN := TRUE, PT := T#500ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* settle *)
        IF ph = 2 AND NOT moved AND NOT CONV_CP_3_Done THEN proxL := PE_42; CONV_CP_3_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND CONV_CP_3_Done THEN
          CONV_CP_3_Trig := FALSE;
          IF NOT CONV_CP_3_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 5; hStep := 1; CONV_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = CONV_CP_3_Cam THEN res_CP_3 := proxL; ph := 5;
          ELSE res_CP_3 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT CONV_CP_3_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          IF NOT (res_CP_3) THEN fRes := CONV_state; CONV_fault := 502; CONV_CP_2_Trig := FALSE; CONV_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; CONV_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSE stp := 2; ph := 0; END_IF;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN (* C5 step 3: set *)
        pickAllowed := TRUE;
        stp := 3;
      END_IF;
      IF stp = 3 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (partPicked AND R2_clearConv) THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 1; hStep := 0; CONV_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE CONV_state := 1; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to C1 *)
        END_IF;
      END_IF;
    98: (* H HOLD: A running transport finishes at the stop; no new transport starts *)
      IF stp = 0 AND NOT moved AND NOT ((((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT)) THEN CONV_state := hRes; stp := hStep; ph := 0; fresh := TRUE; moved := TRUE; END_IF;
    99: (* F FAULT: Missing confirmation or a transport timer expired (belt / drive fault, jam, lost part); the state is entered again *)
      IF clr_HMI_clear THEN clr_HMI_clear := FALSE; CONV_fault := 0; IF fRes = 98 THEN CONV_state := 98; ELSIF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := fRes; hStep := 0; CONV_state := 98; ELSE CONV_state := fRes; END_IF; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF;
  END_CASE;
END_FUNCTION_BLOCK

(* States of R2 (R2_state): 0=initial H=98 F=99 E0=1 E1=2 E2=3 E3=4 E4=5 Q_E4=6 (choice) E5=7 Q_E5=8 (choice) E6=9 E7=10 *)
(* Fault codes of R2 (R2_fault):
   131 E0: communication lost during R2.home
   134 E0: communication lost during GAUGE.master
   104 E0: missing confirmation after GAUGE.master: GAUGE.zeroed
   135 E0: communication lost during R2.home
   199 E0: missing confirmation: R2.home & CP-4 & !CP-5 & GAUGE.zeroed
   232 E1: communication lost during GAUGE.master
   202 E1: missing confirmation after GAUGE.master: GAUGE.zeroed
   233 E1: communication lost during R2.home
   331 E2: communication lost during R2.pickConv
   399 E2: missing confirmation: GR-51 & !CP-3 & R2.clearConv
   431 E3: communication lost during R2.loadGauge
   499 E3: missing confirmation: CP-5 & R2.clearGauge
   531 E4: communication lost during GAUGE.measure
   599 E4: missing confirmation: GAUGE.valid
   732 E5: communication lost during R2.repick
   703 E5: missing confirmation at CP-4: CP-4
   734 E5: communication lost during R2.placePallet
   799 E5: missing confirmation: CAM-2.slot & !GR-51
   931 E6: communication lost during R2.repick
   932 E6: communication lost during R2.dropNok
   999 E6: missing confirmation: PE-65
   1031 E7: communication lost during R2.home
   9831 H: communication lost during R2.park
*)
FUNCTION_BLOCK FB_R2S2
  VAR_EXTERNAL
    R1_state : INT;
    R1_fault : INT;
    CONV_state : INT;
    CONV_fault : INT;
    R2_state : INT;
    R2_fault : INT;
    SUP_state : INT;
    R1_JobNo : INT;
    R1_Start : BOOL;
    R1_Done : BOOL;
    R1_CP_1_Trig : BOOL;
    R1_CP_1_Done : BOOL;
    R1_CP_1_Valid : BOOL;
    R1_CP_1_Cam : BOOL;
    R1_CP_1_Also : BOOL;
    R1_CP_2_Trig : BOOL;
    R1_CP_2_Done : BOOL;
    R1_CP_2_Valid : BOOL;
    R1_CP_2_Cam : BOOL;
    CONV_CP_2_Trig : BOOL;
    CONV_CP_2_Done : BOOL;
    CONV_CP_2_Valid : BOOL;
    CONV_CP_2_Cam : BOOL;
    CONV_CP_3_Trig : BOOL;
    CONV_CP_3_Done : BOOL;
    CONV_CP_3_Valid : BOOL;
    CONV_CP_3_Cam : BOOL;
    R2_JobNo : INT;
    R2_Start : BOOL;
    R2_Done : BOOL;
    R2_CP_4_Trig : BOOL;
    R2_CP_4_Done : BOOL;
    R2_CP_4_Valid : BOOL;
    R2_CP_4_Cam : BOOL;
    R2_CP_5_Trig : BOOL;
    R2_CP_5_Done : BOOL;
    R2_CP_5_Valid : BOOL;
    R2_CP_5_Cam : BOOL;
    R2_CP_3_Trig : BOOL;
    R2_CP_3_Done : BOOL;
    R2_CP_3_Valid : BOOL;
    R2_CP_3_Cam : BOOL;
    HMI_auto : BOOL;
    R1_home : BOOL;
    CNC_ready : BOOL;
    ZS_32_in : BOOL;
    ZS_32 : BOOL;
    GR_21A_in : BOOL;
    GR_21A : BOOL;
    CNC_done : BOOL;
    ZS_33_in : BOOL;
    ZS_33 : BOOL;
    CNC_empty : BOOL;
    ZS_31_in : BOOL;
    ZS_31 : BOOL;
    PS_36_in : BOOL;
    PS_36 : BOOL;
    GR_21B_in : BOOL;
    GR_21B : BOOL;
    ZS_34_in : BOOL;
    ZS_34 : BOOL;
    ZS_35_in : BOOL;
    ZS_35 : BOOL;
    R1_clearCnc : BOOL;
    CNC_run : BOOL;
    ENC_43_in : BOOL;
    ENC_43 : BOOL;
    R1_clearConv : BOOL;
    HMI_loaded : BOOL;
    R2_clearConv : BOOL;
    PE_42_in : BOOL;
    PE_42 : BOOL;
    ROI_C : BOOL;
    R2_home : BOOL;
    GAUGE_zeroed : BOOL;
    GAUGE_due : BOOL;
    GAUGE_due_restart : BOOL;
    GR_51_in : BOOL;
    GR_51 : BOOL;
    R2_clearGauge : BOOL;
    GAUGE_valid : BOOL;
    GAUGE_ok : BOOL;
    CAM_2_slot : BOOL;
    outCount : INT;
    PE_65_in : BOOL;
    PE_65 : BOOL;
    PX_11_in : BOOL;
    PX_11 : BOOL;
    PE_41_in : BOOL;
    PE_41 : BOOL;
    PX_52_in : BOOL;
    PX_52 : BOOL;
    PX_64_in : BOOL;
    PX_64 : BOOL;
    HMI_clear : BOOL;
    E_HMI_clear : BOOL;
    HMI_verify : BOOL;
    L_HMI_verify : BOOL;
    VERIFY_pass : BOOL;
    L_VERIFY_pass : BOOL;
    HMI_reset : BOOL;
    L_HMI_reset : BOOL;
    VERIFY_fail : BOOL;
    L_VERIFY_fail : BOOL;
    HMI_release : BOOL;
    L_HMI_release : BOOL;
    HB : BOOL;
    partPlaced : BOOL;
    pickAllowed : BOOL;
    partPicked : BOOL;
    consecNok : INT;
    QH : BOOL;
    mismatches : INT;
    CAM_FAULT : BOOL;
    COMM_LOST : BOOL;
    mmPending : INT;
    mmClear : BOOL;
    BELT_motor : BOOL;
    LT_53 : BOOL;
    LT_01_red : BOOL;
    LT_01_amber : BOOL;
    LT_01_green : BOOL;
    V_partPlaced : BOOL;
    V_pickAllowed : BOOL;
    V_partPicked : BOOL;
    V_consecNok : INT;
    V_QH : BOOL;
    V_mismatches : INT;
    V_CAM_FAULT : BOOL;
  END_VAR
  VAR
    stp : INT := 0;        (* step of the state; = number of steps once they are done *)
    ph : INT := 0;         (* phase of the running step *)
    hRes : INT := 0;       (* state to resume after H *)
    hStep : INT := 0;      (* step to resume after H (a check repeated after a camera fault) *)
    fRes : INT := 0;       (* state to enter again after F *)
    tries : INT := 0;      (* images taken by the running check *)
    proxL : BOOL;          (* proximity value latched with the camera trigger *)
    fresh : BOOL := TRUE;  (* a state was entered: reset the timers *)
    moved : BOOL;          (* this call changed the state: nothing else runs *)
    tWait : TON;           (* time since the steps of the state were done *)
    tStep : TON;           (* settle, re-trigger and repeat timer of a check *)
    res_CP_4 : BOOL;  (* result of the last check CP-4 of this machine *)
    res_CP_5 : BOOL;  (* result of the last check CP-5 of this machine *)
    res_CP_3 : BOOL;  (* result of the last check CP-3 of this machine *)
    clr_HMI_clear : BOOL;  (* HMI.clear pressed while in F *)
  END_VAR
  (* State diagram: Robot 2 + gauge + sorting (Setup 2) *)
  IF fresh THEN tWait(IN := FALSE); tStep(IN := FALSE); fresh := FALSE; END_IF;
  moved := FALSE;
  IF R2_state = 99 AND E_HMI_clear THEN clr_HMI_clear := TRUE; END_IF;
  CASE R2_state OF
    0: (* initial *)
      IF stp = 0 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF HMI_auto THEN R2_state := 1; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to E0 *)
        END_IF;
      END_IF;
    1: (* E0 START-UP CHECKS *)
      IF stp = 0 AND NOT moved THEN (* E0 step 1: job R2.home *)
        IF ph = 0 THEN
          IF NOT (NOT (R2_home)) THEN stp := 1;
          ELSIF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 14; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 131; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 1;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved THEN (* E0 step 2: check CP-4 *)
        IF ph = 0 THEN
          tries := 0; ph := 1;
        END_IF;
        IF ph = 1 AND NOT moved THEN tStep(IN := TRUE, PT := T#500ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* settle *)
        IF ph = 2 AND NOT moved AND NOT R2_CP_4_Done THEN proxL := PX_52; R2_CP_4_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND R2_CP_4_Done THEN
          R2_CP_4_Trig := FALSE;
          IF NOT R2_CP_4_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 1; hStep := 1; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = R2_CP_4_Cam THEN res_CP_4 := proxL; ph := 5;
          ELSE res_CP_4 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT R2_CP_4_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          stp := 2; ph := 0;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN (* E0 step 3: check CP-5 *)
        IF ph = 0 THEN
          tries := 0; ph := 2;
        END_IF;
        IF ph = 2 AND NOT moved AND NOT R2_CP_5_Done THEN proxL := PX_64; R2_CP_5_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND R2_CP_5_Done THEN
          R2_CP_5_Trig := FALSE;
          IF NOT R2_CP_5_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 1; hStep := 2; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = R2_CP_5_Cam THEN res_CP_5 := proxL; ph := 5;
          ELSE res_CP_5 := TRUE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule present *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT R2_CP_5_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          stp := 3; ph := 0;
        END_IF;
      END_IF;
      IF stp = 3 AND NOT moved THEN (* E0 step 4: job GAUGE.master *)
        IF ph = 0 THEN
          IF NOT (NOT (res_CP_5)) THEN stp := 4;
          ELSIF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 22; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 134; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            IF GAUGE_zeroed THEN GAUGE_due_restart := TRUE; END_IF;
            IF NOT (GAUGE_zeroed) THEN fRes := R2_state; R2_fault := 104; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
            ELSE ph := 2; END_IF;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 4;
        END_IF;
      END_IF;
      IF stp = 4 AND NOT moved THEN (* E0 step 5: job R2.home *)
        IF ph = 0 THEN
          IF NOT (NOT (R2_home)) THEN stp := 5;
          ELSIF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 14; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 135; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 5;
        END_IF;
      END_IF;
      IF stp = 5 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (R2_home AND res_CP_4 AND NOT (res_CP_5) AND GAUGE_zeroed) THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 2; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R2_state := 2; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to E1 *)
        ELSIF tWait.ET >= T#1000ms THEN fRes := R2_state; R2_fault := 199; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    2: (* E1 WAIT FOR PART - waiting *)
      IF stp = 0 AND NOT moved THEN (* E1 step 1: check CP-5 *)
        IF ph = 0 THEN
          IF NOT ((GAUGE_due OR NOT (GAUGE_zeroed))) THEN stp := 1; ELSE tries := 0; ph := 2; END_IF;
        END_IF;
        IF ph = 2 AND NOT moved AND NOT R2_CP_5_Done THEN proxL := PX_64; R2_CP_5_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND R2_CP_5_Done THEN
          R2_CP_5_Trig := FALSE;
          IF NOT R2_CP_5_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 2; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = R2_CP_5_Cam THEN res_CP_5 := proxL; ph := 5;
          ELSE res_CP_5 := TRUE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule present *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT R2_CP_5_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          stp := 1; ph := 0;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved THEN (* E1 step 2: job GAUGE.master *)
        IF ph = 0 THEN
          IF NOT (((GAUGE_due OR NOT (GAUGE_zeroed)) AND NOT (res_CP_5))) THEN stp := 2;
          ELSIF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 22; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 232; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            IF GAUGE_zeroed THEN GAUGE_due_restart := TRUE; END_IF;
            IF NOT (GAUGE_zeroed) THEN fRes := R2_state; R2_fault := 202; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
            ELSE ph := 2; END_IF;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 2;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN (* E1 step 3: job R2.home *)
        IF ph = 0 THEN
          IF NOT (NOT (R2_home)) THEN stp := 3;
          ELSIF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 14; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 233; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 3;
        END_IF;
      END_IF;
      IF stp = 3 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF ((CONV_state = 5) AND pickAllowed AND NOT (ENC_43) AND GAUGE_zeroed) THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 3; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R2_state := 3; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to E2 *)
        ELSIF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 2; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    3: (* E2 PICK FROM CONVEYOR *)
      IF stp = 0 AND NOT moved THEN (* E2 step 1: job R2.pickConv *)
        IF ph = 0 THEN
          IF NOT (NOT (GR_51)) THEN stp := 1;
          ELSIF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 16; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 331; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 1;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved THEN (* E2 step 2: check CP-3 *)
        IF ph = 0 THEN
          tries := 0; ph := 2;
        END_IF;
        IF ph = 2 AND NOT moved AND NOT R2_CP_3_Done THEN proxL := PE_42; R2_CP_3_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND R2_CP_3_Done THEN
          R2_CP_3_Trig := FALSE;
          IF NOT R2_CP_3_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 3; hStep := 1; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = R2_CP_3_Cam THEN res_CP_3 := proxL; ph := 5;
          ELSE res_CP_3 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT R2_CP_3_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          stp := 2; ph := 0;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN (* E2 step 3: set *)
        IF (GR_51 AND NOT (res_CP_3)) THEN partPicked := TRUE; pickAllowed := FALSE; END_IF;
        stp := 3;
      END_IF;
      IF stp = 3 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (GR_51 AND NOT (res_CP_3) AND R2_clearConv) THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 4; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R2_state := 4; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to E3 *)
        ELSIF tWait.ET >= T#1000ms THEN fRes := R2_state; R2_fault := 399; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    4: (* E3 LOAD GAUGE *)
      IF stp = 0 AND NOT moved THEN (* E3 step 1: job R2.loadGauge *)
        IF ph = 0 THEN
          IF NOT (GR_51) THEN stp := 1;
          ELSIF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 18; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 431; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 1;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved THEN (* E3 step 2: check CP-5 *)
        IF ph = 0 THEN
          tries := 0; ph := 1;
        END_IF;
        IF ph = 1 AND NOT moved THEN tStep(IN := TRUE, PT := T#500ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* settle *)
        IF ph = 2 AND NOT moved AND NOT R2_CP_5_Done THEN proxL := PX_64; R2_CP_5_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND R2_CP_5_Done THEN
          R2_CP_5_Trig := FALSE;
          IF NOT R2_CP_5_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 4; hStep := 1; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = R2_CP_5_Cam THEN res_CP_5 := proxL; ph := 5;
          ELSE res_CP_5 := TRUE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule present *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT R2_CP_5_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          stp := 2; ph := 0;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (res_CP_5 AND R2_clearGauge) THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 5; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R2_state := 5; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to E4 *)
        ELSIF tWait.ET >= T#1000ms THEN fRes := R2_state; R2_fault := 499; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    5: (* E4 MEASURE L, W, H *)
      IF stp = 0 AND NOT moved THEN (* E4 step 1: job GAUGE.measure *)
        IF ph = 0 THEN
          IF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 21; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 531; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 1;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF GAUGE_valid THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 6; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R2_state := 6; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to Q_E4 *)
        ELSIF tWait.ET >= T#1000ms THEN fRes := R2_state; R2_fault := 599; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    7: (* E5 PLACE OK PART ON PALLET *)
      IF stp = 0 AND NOT moved THEN (* E5 step 1: set *)
        consecNok := 0;
        stp := 1;
      END_IF;
      IF stp = 1 AND NOT moved THEN (* E5 step 2: job R2.repick *)
        IF ph = 0 THEN
          IF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 19; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 732; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 2;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN (* E5 step 3: check CP-4 *)
        IF ph = 0 THEN
          tries := 0; ph := 1;
        END_IF;
        IF ph = 1 AND NOT moved THEN tStep(IN := TRUE, PT := T#500ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* settle *)
        IF ph = 2 AND NOT moved AND NOT R2_CP_4_Done THEN proxL := PX_52; R2_CP_4_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND R2_CP_4_Done THEN
          R2_CP_4_Trig := FALSE;
          IF NOT R2_CP_4_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 7; hStep := 2; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = R2_CP_4_Cam THEN res_CP_4 := proxL; ph := 5;
          ELSE res_CP_4 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT R2_CP_4_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          IF NOT (res_CP_4) THEN fRes := R2_state; R2_fault := 703; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSE stp := 3; ph := 0; END_IF;
        END_IF;
      END_IF;
      IF stp = 3 AND NOT moved THEN (* E5 step 4: job R2.placePallet *)
        IF ph = 0 THEN
          IF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 17; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 734; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 4;
        END_IF;
      END_IF;
      IF stp = 4 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (CAM_2_slot AND NOT (GR_51)) THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 8; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R2_state := 8; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to Q_E5 *)
        ELSIF tWait.ET >= T#1000ms THEN fRes := R2_state; R2_fault := 799; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    9: (* E6 PLACE IN NOK CHUTE *)
      IF stp = 0 AND NOT moved THEN (* E6 step 1: job R2.repick *)
        IF ph = 0 THEN
          IF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 19; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 931; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 1;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved THEN (* E6 step 2: job R2.dropNok *)
        IF ph = 0 THEN
          IF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 20; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 932; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 2;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN (* E6 step 3: set *)
        consecNok := MIN(consecNok + 1, 2);
        stp := 3;
      END_IF;
      IF stp = 3 AND NOT moved THEN (* E6 step 4: set *)
        IF (consecNok >= 2) THEN QH := TRUE; END_IF;
        stp := 4;
      END_IF;
      IF stp = 4 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF PE_65 THEN PE_65 := FALSE; IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 2; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R2_state := 2; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to E1 *)
        ELSIF tWait.ET >= T#1000ms THEN fRes := R2_state; R2_fault := 999; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    10: (* E7 WAIT FOR PALLET SWAP - waiting *)
      IF stp = 0 AND NOT moved THEN (* E7 step 1: job R2.home *)
        IF ph = 0 THEN
          IF NOT (NOT (R2_home)) THEN stp := 1;
          ELSIF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 14; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 1031; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 1;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved THEN (* E7 step 2: await PALLET.empty *)
        IF (outCount = 0) THEN stp := 2;
        ELSIF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 10; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
      IF stp = 2 AND NOT moved THEN (* E7 step 3: check CP-4 *)
        IF ph = 0 THEN
          tries := 0; ph := 1;
        END_IF;
        IF ph = 1 AND NOT moved THEN tStep(IN := TRUE, PT := T#500ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* settle *)
        IF ph = 2 AND NOT moved AND NOT R2_CP_4_Done THEN proxL := PX_52; R2_CP_4_Trig := TRUE; ph := 3; END_IF;
        IF ph = 3 AND NOT moved AND R2_CP_4_Done THEN
          R2_CP_4_Trig := FALSE;
          IF NOT R2_CP_4_Valid THEN (* invalid image: one re-trigger, then camera fault *)
            tries := tries + 1;
            IF tries >= 2 THEN CAM_FAULT := TRUE; hRes := 10; hStep := 2; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 4; END_IF;
          ELSIF proxL = R2_CP_4_Cam THEN res_CP_4 := proxL; ph := 5;
          ELSE res_CP_4 := FALSE; mmPending := mmPending + 1; mismatches := MIN(mismatches + 1, 3); ph := 5; (* disagreement: rule absent *)
          END_IF;
        END_IF;
        IF ph = 4 AND NOT moved AND NOT R2_CP_4_Done THEN tStep(IN := TRUE, PT := T#300ms); IF tStep.Q THEN tStep(IN := FALSE); ph := 2; END_IF; END_IF; (* re-trigger *)
        IF ph = 5 AND NOT moved THEN
          IF NOT (res_CP_4) THEN
            IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 10; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE ph := 6; END_IF;
          ELSE
            stp := 3; ph := 0;
          END_IF;
        END_IF;
        IF ph = 6 AND NOT moved THEN tStep(IN := TRUE, PT := T#500ms); IF tStep.Q THEN tStep(IN := FALSE); tries := 0; ph := 1; END_IF; END_IF; (* repeat until CP-4 *)
      END_IF;
      IF stp = 3 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (res_CP_4 AND (outCount = 0)) THEN IF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 2; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; ELSE R2_state := 2; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF; (* to E1 *)
        ELSIF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := 10; hStep := 0; R2_state := 98; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
        END_IF;
      END_IF;
    98: (* H HOLD: LINE STOP: finish the step, park, wait for the reset *)
      IF stp = 0 AND NOT moved THEN (* H step 1: job R2.park *)
        IF ph = 0 THEN
          IF NOT COMM_LOST AND NOT R2_Done THEN R2_JobNo := 15; R2_Start := TRUE; ph := 1;
          END_IF;
        ELSIF ph = 1 THEN
          IF COMM_LOST THEN fRes := R2_state; R2_fault := 9831; R2_Start := FALSE; R2_CP_4_Trig := FALSE; R2_CP_5_Trig := FALSE; R2_CP_3_Trig := FALSE; clr_HMI_clear := FALSE; R2_state := 99; stp := 0; ph := 0; fresh := TRUE; moved := TRUE;
          ELSIF R2_Done THEN
            R2_Start := FALSE;
            ph := 2;
          END_IF;
        ELSIF ph = 2 AND NOT R2_Done THEN ph := 0; stp := 1;
        END_IF;
      END_IF;
      IF stp = 1 AND NOT moved AND NOT ((((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT)) THEN R2_state := hRes; stp := hStep; ph := 0; fresh := TRUE; moved := TRUE; END_IF;
    99: (* F FAULT: From any state: timeout or a missing confirmation - red light; the state is entered again *)
      IF clr_HMI_clear THEN clr_HMI_clear := FALSE; R2_fault := 0; IF fRes = 98 THEN R2_state := 98; ELSIF (((SUP_state = 3) OR (SUP_state = 4)) OR CAM_FAULT) THEN hRes := fRes; hStep := 0; R2_state := 98; ELSE R2_state := fRes; END_IF; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; END_IF;
  END_CASE;
  CASE R2_state OF (* choice states *)
    6: IF GAUGE_ok THEN R2_state := 7; ELSE R2_state := 9; END_IF; (* Q_E4: GAUGE.ok *)
    8: IF (outCount >= 12) THEN R2_state := 10; ELSE R2_state := 2; END_IF; (* Q_E5: PALLET.full *)
  END_CASE;
  CASE R2_state OF (* choice states *)
    6: IF GAUGE_ok THEN R2_state := 7; ELSE R2_state := 9; END_IF; (* Q_E4: GAUGE.ok *)
    8: IF (outCount >= 12) THEN R2_state := 10; ELSE R2_state := 2; END_IF; (* Q_E5: PALLET.full *)
  END_CASE;
END_FUNCTION_BLOCK

(* States of SUP (SUP_state): 0=initial H=98 F=99 X1=1 X2=2 X3=3 X4=4 *)
FUNCTION_BLOCK FB_SUP
  VAR_EXTERNAL
    R1_state : INT;
    R1_fault : INT;
    CONV_state : INT;
    CONV_fault : INT;
    R2_state : INT;
    R2_fault : INT;
    SUP_state : INT;
    R1_JobNo : INT;
    R1_Start : BOOL;
    R1_Done : BOOL;
    R1_CP_1_Trig : BOOL;
    R1_CP_1_Done : BOOL;
    R1_CP_1_Valid : BOOL;
    R1_CP_1_Cam : BOOL;
    R1_CP_1_Also : BOOL;
    R1_CP_2_Trig : BOOL;
    R1_CP_2_Done : BOOL;
    R1_CP_2_Valid : BOOL;
    R1_CP_2_Cam : BOOL;
    CONV_CP_2_Trig : BOOL;
    CONV_CP_2_Done : BOOL;
    CONV_CP_2_Valid : BOOL;
    CONV_CP_2_Cam : BOOL;
    CONV_CP_3_Trig : BOOL;
    CONV_CP_3_Done : BOOL;
    CONV_CP_3_Valid : BOOL;
    CONV_CP_3_Cam : BOOL;
    R2_JobNo : INT;
    R2_Start : BOOL;
    R2_Done : BOOL;
    R2_CP_4_Trig : BOOL;
    R2_CP_4_Done : BOOL;
    R2_CP_4_Valid : BOOL;
    R2_CP_4_Cam : BOOL;
    R2_CP_5_Trig : BOOL;
    R2_CP_5_Done : BOOL;
    R2_CP_5_Valid : BOOL;
    R2_CP_5_Cam : BOOL;
    R2_CP_3_Trig : BOOL;
    R2_CP_3_Done : BOOL;
    R2_CP_3_Valid : BOOL;
    R2_CP_3_Cam : BOOL;
    HMI_auto : BOOL;
    R1_home : BOOL;
    CNC_ready : BOOL;
    ZS_32_in : BOOL;
    ZS_32 : BOOL;
    GR_21A_in : BOOL;
    GR_21A : BOOL;
    CNC_done : BOOL;
    ZS_33_in : BOOL;
    ZS_33 : BOOL;
    CNC_empty : BOOL;
    ZS_31_in : BOOL;
    ZS_31 : BOOL;
    PS_36_in : BOOL;
    PS_36 : BOOL;
    GR_21B_in : BOOL;
    GR_21B : BOOL;
    ZS_34_in : BOOL;
    ZS_34 : BOOL;
    ZS_35_in : BOOL;
    ZS_35 : BOOL;
    R1_clearCnc : BOOL;
    CNC_run : BOOL;
    ENC_43_in : BOOL;
    ENC_43 : BOOL;
    R1_clearConv : BOOL;
    HMI_loaded : BOOL;
    R2_clearConv : BOOL;
    PE_42_in : BOOL;
    PE_42 : BOOL;
    ROI_C : BOOL;
    R2_home : BOOL;
    GAUGE_zeroed : BOOL;
    GAUGE_due : BOOL;
    GAUGE_due_restart : BOOL;
    GR_51_in : BOOL;
    GR_51 : BOOL;
    R2_clearGauge : BOOL;
    GAUGE_valid : BOOL;
    GAUGE_ok : BOOL;
    CAM_2_slot : BOOL;
    outCount : INT;
    PE_65_in : BOOL;
    PE_65 : BOOL;
    PX_11_in : BOOL;
    PX_11 : BOOL;
    PE_41_in : BOOL;
    PE_41 : BOOL;
    PX_52_in : BOOL;
    PX_52 : BOOL;
    PX_64_in : BOOL;
    PX_64 : BOOL;
    HMI_clear : BOOL;
    E_HMI_clear : BOOL;
    HMI_verify : BOOL;
    L_HMI_verify : BOOL;
    VERIFY_pass : BOOL;
    L_VERIFY_pass : BOOL;
    HMI_reset : BOOL;
    L_HMI_reset : BOOL;
    VERIFY_fail : BOOL;
    L_VERIFY_fail : BOOL;
    HMI_release : BOOL;
    L_HMI_release : BOOL;
    HB : BOOL;
    partPlaced : BOOL;
    pickAllowed : BOOL;
    partPicked : BOOL;
    consecNok : INT;
    QH : BOOL;
    mismatches : INT;
    CAM_FAULT : BOOL;
    COMM_LOST : BOOL;
    mmPending : INT;
    mmClear : BOOL;
    BELT_motor : BOOL;
    LT_53 : BOOL;
    LT_01_red : BOOL;
    LT_01_amber : BOOL;
    LT_01_green : BOOL;
    V_partPlaced : BOOL;
    V_pickAllowed : BOOL;
    V_partPicked : BOOL;
    V_consecNok : INT;
    V_QH : BOOL;
    V_mismatches : INT;
    V_CAM_FAULT : BOOL;
  END_VAR
  VAR
    stp : INT := 0;        (* step of the state; = number of steps once they are done *)
    ph : INT := 0;         (* phase of the running step *)
    hRes : INT := 0;       (* state to resume after H *)
    hStep : INT := 0;      (* step to resume after H (a check repeated after a camera fault) *)
    fRes : INT := 0;       (* state to enter again after F *)
    tries : INT := 0;      (* images taken by the running check *)
    proxL : BOOL;          (* proximity value latched with the camera trigger *)
    fresh : BOOL := TRUE;  (* a state was entered: reset the timers *)
    moved : BOOL;          (* this call changed the state: nothing else runs *)
    tWait : TON;           (* time since the steps of the state were done *)
    tStep : TON;           (* settle, re-trigger and repeat timer of a check *)
    clr_HMI_clear : BOOL;  (* HMI.clear pressed while in F *)
  END_VAR
  (* State diagram: cross-check supervisor (camera vs proximity) *)
  IF fresh THEN tWait(IN := FALSE); tStep(IN := FALSE); fresh := FALSE; END_IF;
  moved := FALSE;
  IF SUP_state = 99 AND E_HMI_clear THEN clr_HMI_clear := TRUE; END_IF;
  CASE SUP_state OF
    0: (* initial *)
      IF stp = 0 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF TRUE THEN SUP_state := 1; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to X1 *)
        END_IF;
      END_IF;
    1: (* X1 NORMAL - waiting - not interrupted by a LINE STOP *)
      IF stp = 0 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF CAM_FAULT THEN SUP_state := 3; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to X3 *)
        ELSIF (mismatches > 0) THEN SUP_state := 2; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to X2 *)
        END_IF;
      END_IF;
    2: (* X2 MISMATCH WARNING - waiting - not interrupted by a LINE STOP *)
      IF stp = 0 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF ((mismatches >= 3) OR CAM_FAULT) THEN SUP_state := 3; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to X3 *)
        ELSIF (mismatches = 0) THEN SUP_state := 1; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to X1 *)
        END_IF;
      END_IF;
    3: (* X3 LINE STOP - waiting - not interrupted by a LINE STOP *)
      IF stp = 0 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF ((R1_home AND R2_home AND NOT (ENC_43)) AND L_HMI_verify) THEN L_HMI_verify := FALSE; SUP_state := 4; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to X4 *)
        END_IF;
      END_IF;
    4: (* X4 SENSOR VERIFICATION - waiting - not interrupted by a LINE STOP *)
      IF stp = 0 AND NOT moved THEN
        tWait(IN := TRUE, PT := T#24h);
        IF (L_VERIFY_pass AND L_HMI_reset) THEN L_VERIFY_pass := FALSE; L_HMI_reset := FALSE; mismatches := 0; mmPending := 0; mmClear := TRUE; CAM_FAULT := FALSE; SUP_state := 1; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to X1 *)
        ELSIF L_VERIFY_fail THEN L_VERIFY_fail := FALSE; SUP_state := 4; stp := 0; ph := 0; fresh := TRUE; moved := TRUE; (* to X4 *)
        END_IF;
      END_IF;
  END_CASE;
END_FUNCTION_BLOCK

