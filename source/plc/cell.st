    COMM_LOST : BOOL;
    mmPending : INT;
    mmClear : BOOL;
    BELT_motor : BOOL;
    LT_53 : BOOL;
    LT_01_red : BOOL;
    LT_01_amber : BOOL;
    LT_01_green : BOOL;
    V_partPlaced : BOOL;
    V_pickAllowed : BOOL;
    V_partPicked : BOOL;
    V_consecNok : INT;
    V_QH : BOOL;
    V_mismatches : INT;
    V_CAM_FAULT : BOOL;
  END_VAR
  VAR
    fbR1S2 : FB_R1S2;
    fbCONV : FB_CONV;
    fbR2S2 : FB_R2S2;
    fbSUP : FB_SUP;
    hbT : TON;
    hbLast : BOOL;
    n : INT;
    oldest : INT;
    best : TIME;
    db_ZS_32 : TON;
    db_GR_21A : TON;
    db_ZS_33 : TON;
    db_ZS_31 : TON;
    db_PS_36 : TON;
    db_GR_21B : TON;
    db_ZS_34 : TON;
    db_ZS_35 : TON;
    db_ENC_43 : TON;
    db_PE_42 : TON;
    db_GR_51 : TON;
    db_PX_11 : TON;
    db_PE_41 : TON;
    db_PX_52 : TON;
    db_PX_64 : TON;
    rt_PE_65 : R_TRIG;
    rt_HMI_clear : R_TRIG;
    rt_HMI_verify : R_TRIG;
    rt_VERIFY_pass : R_TRIG;
    rt_HMI_reset : R_TRIG;
    rt_VERIFY_fail : R_TRIG;
    rt_HMI_release : R_TRIG;
    mmOn1 : BOOL;
    mmT1 : TON;
    mmOn2 : BOOL;
    mmT2 : TON;
    mmOn3 : BOOL;
    mmT3 : TON;
    tm_GAUGE_due : TON;
  END_VAR
  (* 1. inputs: heartbeat, debounce, latches, mismatch window, PLC timers *)
  hbT(IN := HB = hbLast, PT := T#500ms); hbLast := HB; COMM_LOST := hbT.Q;
  db_ZS_32(IN := ZS_32_in <> ZS_32, PT := T#50ms); IF db_ZS_32.Q THEN ZS_32 := ZS_32_in; END_IF;
  db_GR_21A(IN := GR_21A_in <> GR_21A, PT := T#50ms); IF db_GR_21A.Q THEN GR_21A := GR_21A_in; END_IF;
  db_ZS_33(IN := ZS_33_in <> ZS_33, PT := T#50ms); IF db_ZS_33.Q THEN ZS_33 := ZS_33_in; END_IF;
  db_ZS_31(IN := ZS_31_in <> ZS_31, PT := T#50ms); IF db_ZS_31.Q THEN ZS_31 := ZS_31_in; END_IF;
  db_PS_36(IN := PS_36_in <> PS_36, PT := T#50ms); IF db_PS_36.Q THEN PS_36 := PS_36_in; END_IF;
  db_GR_21B(IN := GR_21B_in <> GR_21B, PT := T#50ms); IF db_GR_21B.Q THEN GR_21B := GR_21B_in; END_IF;
  db_ZS_34(IN := ZS_34_in <> ZS_34, PT := T#50ms); IF db_ZS_34.Q THEN ZS_34 := ZS_34_in; END_IF;
  db_ZS_35(IN := ZS_35_in <> ZS_35, PT := T#50ms); IF db_ZS_35.Q THEN ZS_35 := ZS_35_in; END_IF;
  db_ENC_43(IN := ENC_43_in <> ENC_43, PT := T#50ms); IF db_ENC_43.Q THEN ENC_43 := ENC_43_in; END_IF;
  db_PE_42(IN := PE_42_in <> PE_42, PT := T#50ms); IF db_PE_42.Q THEN PE_42 := PE_42_in; END_IF;
  db_GR_51(IN := GR_51_in <> GR_51, PT := T#50ms); IF db_GR_51.Q THEN GR_51 := GR_51_in; END_IF;
  db_PX_11(IN := PX_11_in <> PX_11, PT := T#50ms); IF db_PX_11.Q THEN PX_11 := PX_11_in; END_IF;
  db_PE_41(IN := PE_41_in <> PE_41, PT := T#50ms); IF db_PE_41.Q THEN PE_41 := PE_41_in; END_IF;
  db_PX_52(IN := PX_52_in <> PX_52, PT := T#50ms); IF db_PX_52.Q THEN PX_52 := PX_52_in; END_IF;
  db_PX_64(IN := PX_64_in <> PX_64, PT := T#50ms); IF db_PX_64.Q THEN PX_64 := PX_64_in; END_IF;
  rt_PE_65(CLK := PE_65_in); IF rt_PE_65.Q THEN PE_65 := TRUE; END_IF;
  rt_HMI_clear(CLK := HMI_clear); E_HMI_clear := rt_HMI_clear.Q;
  rt_HMI_verify(CLK := HMI_verify); IF rt_HMI_verify.Q THEN L_HMI_verify := TRUE; END_IF;
  rt_VERIFY_pass(CLK := VERIFY_pass); IF rt_VERIFY_pass.Q THEN L_VERIFY_pass := TRUE; END_IF;
  rt_HMI_reset(CLK := HMI_reset); IF rt_HMI_reset.Q THEN L_HMI_reset := TRUE; END_IF;
  rt_VERIFY_fail(CLK := VERIFY_fail); IF rt_VERIFY_fail.Q THEN L_VERIFY_fail := TRUE; END_IF;
  rt_HMI_release(CLK := HMI_release); IF rt_HMI_release.Q THEN L_HMI_release := TRUE; END_IF;
  IF mmClear THEN mmOn1 := FALSE; mmOn2 := FALSE; mmOn3 := FALSE; mmClear := FALSE; END_IF;
  WHILE mmPending > 0 DO (* a new mismatch event: a free place, or the oldest one is replaced *)
    oldest := 0; best := T#0ms;
    IF oldest >= 0 AND NOT mmOn1 THEN oldest := -1; ELSIF oldest >= 0 AND mmT1.ET >= best THEN best := mmT1.ET; oldest := 1; END_IF;
    IF oldest >= 0 AND NOT mmOn2 THEN oldest := -2; ELSIF oldest >= 0 AND mmT2.ET >= best THEN best := mmT2.ET; oldest := 2; END_IF;
    IF oldest >= 0 AND NOT mmOn3 THEN oldest := -3; ELSIF oldest >= 0 AND mmT3.ET >= best THEN best := mmT3.ET; oldest := 3; END_IF;
    IF oldest < 0 THEN oldest := -oldest; END_IF;
    IF oldest = 1 THEN mmOn1 := TRUE; mmT1(IN := FALSE); END_IF;
    IF oldest = 2 THEN mmOn2 := TRUE; mmT2(IN := FALSE); END_IF;
    IF oldest = 3 THEN mmOn3 := TRUE; mmT3(IN := FALSE); END_IF;
    mmPending := mmPending - 1;
  END_WHILE;
  n := 0;
  mmT1(IN := mmOn1, PT := T#600000ms); IF mmT1.Q THEN mmOn1 := FALSE; mmT1(IN := FALSE); END_IF; IF mmOn1 THEN n := n + 1; END_IF;
  mmT2(IN := mmOn2, PT := T#600000ms); IF mmT2.Q THEN mmOn2 := FALSE; mmT2(IN := FALSE); END_IF; IF mmOn2 THEN n := n + 1; END_IF;
  mmT3(IN := mmOn3, PT := T#600000ms); IF mmT3.Q THEN mmOn3 := FALSE; mmT3(IN := FALSE); END_IF; IF mmOn3 THEN n := n + 1; END_IF;
  mismatches := n;
  IF GAUGE_due_restart THEN tm_GAUGE_due(IN := FALSE); GAUGE_due_restart := FALSE; END_IF;
  tm_GAUGE_due(IN := GAUGE_zeroed, PT := T#14400000ms); GAUGE_due := tm_GAUGE_due.Q;
  
  (* 2. machines in a fixed order; the urgent supervisor first and after every other machine *)
  fbSUP();
  fbR1S2();
  fbSUP();
  fbCONV();
  fbSUP();
  fbR2S2();
  IF (L_HMI_release AND QH) THEN QH := FALSE; consecNok := 0; L_HMI_release := FALSE; END_IF; (* rung: tool and offsets checked -> quality hold released *)
  fbSUP();
  
  (* 3. outputs *)
  BELT_motor := (CONV_state = 3) AND NOT COMM_LOST;
  LT_53 := (R2_state = 10);
  LT_01_red := (((SUP_state = 3) OR (SUP_state = 4)) OR ((R1_state = 99) OR (CONV_state = 99) OR (R2_state = 99)));
  LT_01_amber := (NOT (((SUP_state = 3) OR (SUP_state = 4))) AND NOT (((R1_state = 99) OR (CONV_state = 99) OR (R2_state = 99))) AND ((mismatches > 0) OR QH OR (R1_state = 10)));
  LT_01_green := (NOT (((SUP_state = 3) OR (SUP_state = 4))) AND NOT (((R1_state = 99) OR (CONV_state = 99) OR (R2_state = 99))) AND NOT (((mismatches > 0) OR QH OR (R1_state = 10))));
  V_partPlaced := partPlaced;
  V_pickAllowed := pickAllowed;
  V_partPicked := partPicked;
  V_consecNok := consecNok;
  V_QH := QH;
  V_mismatches := mismatches;
  V_CAM_FAULT := CAM_FAULT;
END_PROGRAM

