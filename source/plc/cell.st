    PX_52_in : BOOL;
    PX_52 : BOOL;
    PX_64_in : BOOL;
    PX_64 : BOOL;
    HMI_clear : BOOL;
    E_HMI_clear : BOOL;
    HMI_verify : BOOL;
    L_HMI_verify : BOOL;
    VERIFY_pass : BOOL;
    L_VERIFY_pass : BOOL;
    HMI_reset : BOOL;
    L_HMI_reset : BOOL;
    VERIFY_fail : BOOL;
    L_VERIFY_fail : BOOL;
    HMI_release : BOOL;
    L_HMI_release : BOOL;
    HB : BOOL;
    partPlaced : BOOL;
    pickAllowed : BOOL;
    partPicked : BOOL;
    consecNok : INT;
    QH : BOOL;
    mismatches : INT;
